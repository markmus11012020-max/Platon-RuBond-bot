# LLM via AiTunnel (OpenAI-compatible)
AITUNNEL_API_KEY=
AITUNNEL_BASE_URL=https://api.aitunnel.ru/v1
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
AGENT_TEMPERATURE=0.1
AGENT_MAX_ITERATIONS=8

# Pinecone
PINECONE_API_KEY=
PINECONE_ENV=
PINECONE_INDEX=platon-rubond

# Local DBs (optional overrides)
# HISTORY_DB=history.db
# PORTFOLIO_DB=portfolio.db

# ---------- VK bond bot (bondbot) ----------
BONDBOT_DB_PATH=bondbot.db
BONDBOT_VK_GROUP_TOKEN=
BONDBOT_VK_GROUP_ID=
BONDBOT_VK_ADMIN_USER_ID=
BONDBOT_HEALTH_PORT=8081
BONDBOT_SMARTLAB_PAGES=3
BONDBOT_POSITION_SIZE_RUB=1000000
BONDBOT_MAX_PCT_DAILY_VOLUME=0.05
BONDBOT_EXIT_HORIZON_DAYS=5
BONDBOT_MIN_YIELD_PCT=14

# Планировщик (время МСК)
BONDBOT_SCHEDULER_ENABLED=1
BONDBOT_REFRESH_HOUR=23
BONDBOT_REFRESH_MINUTE=30
BONDBOT_DETAIL_REFRESH_HOUR=10
BONDBOT_DETAIL_REFRESH_MINUTE=0
BONDBOT_DIGEST_HOUR=9
BONDBOT_DIGEST_MINUTE=0
BONDBOT_DATA_STALE_HOURS=36

# Алерты (только владелец)
BONDBOT_OWNER_PEER_ID=
BONDBOT_ALERTS_ENABLED=1
BONDBOT_ALERT_QUIET_START=23
BONDBOT_ALERT_QUIET_END=8
BONDBOT_ALERT_MAX_PER_DAY=10

# Бэкапы (внутри контейнера)
BONDBOT_BACKUP_ENABLED=1
BONDBOT_BACKUP_DIR=/data/backups
BONDBOT_BACKUP_KEEP=14

# MOEX ISS
BONDBOT_MOEX_ENABLED=1
BONDBOT_MOEX_BASE=https://iss.moex.com

# Новости (RSS). Пусто = встроенный список источников
BONDBOT_NEWS_ENABLED=1
BONDBOT_NEWS_FEEDS=
BONDBOT_NEWS_INTERVAL_MINUTES=30
BONDBOT_NEWS_HOURS=24

# LLM-ассистент
BONDBOT_LLM_ENABLED=1
BONDBOT_LLM_MAX_TOOL_ROUNDS=4
BONDBOT_LLM_MAX_TOKENS=900
BONDBOT_LLM_TIMEOUT=45
# Fallback, если ставку ЦБ получить не удалось
BONDBOT_MAX_YIELD_PCT=35
# Динамический лимит: ставка ЦБ + маржа, п.п.
BONDBOT_DYNAMIC_MAX_YIELD=1
BONDBOT_KEY_RATE_MARGIN_PCT=10
BONDBOT_KEY_RATE_TTL_HOURS=6
BONDBOT_KEY_RATE_TIMEOUT=15
BONDBOT_KEY_RATE_URL=https://www.cbr.ru/hd_base/KeyRate/
BONDBOT_MAX_DURATION_YEARS=5
BONDBOT_MIN_RATING=A-
BONDBOT_MIN_PRICE_PCT=90
BONDBOT_MAX_PRICE_PCT=110
BONDBOT_OPENAI_BASE_URL=https://api.aitunnel.ru/v1
BONDBOT_OPENAI_API_KEY=
BONDBOT_OPENAI_MODEL=deepseek-v4.1-flash-1017
